# 内容发布台入口
# 每个内部 Tab 可单独设置密码；旧的 ITL_ACCESS_PASSWORD 仍兼容
TOOLKIT_INTHELOOP_PASSWORD=replace-with-a-strong-shared-password
ITL_ACCESS_PASSWORD=
ITL_SESSION_SECRET=replace-with-a-long-random-secret
ITL_COOKIE_SECURE=true
ITL_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_SITE_ORIGIN=https://toolkit-intheloop.geekpark.net
ITL_DATABASE_PATH=/data/toolkit.db
ITL_IMPORT_ASSET_PATH=/data/import-assets
ITL_AGENT_API_KEY=replace-with-a-long-random-agent-key

# 飞书公开文档：无需 App ID / Secret
FEISHU_FETCH_MODE=public
FEISHU_PUBLIC_TIMEOUT_MS=60000
ITL_PUBLIC_IMAGE_CACHE_DIR=/tmp/intheloop-public-images
ITL_PUBLIC_IMAGE_TTL_SECONDS=86400
ITL_PUBLIC_IMAGE_MAX_BYTES=20971520

# 微信公众号
WECHAT_APP_ID=wx0ad9c0e3d4f70a6c
WECHAT_APP_SECRET=
WECHAT_ACCOUNT_NAME=In The Loop.具身现场
WECHAT_API_BASE=https://api.weixin.qq.com/cgi-bin
WECHAT_THUMB_MEDIA_ID=

# 极客公园官网后台
GEEKPARK_LOGIN_NAME=
GEEKPARK_LOGIN_PASSWORD=
WEBSITE_GEEKPARK_API_BASE=https://mainssl.geekpark.net
WEBSITE_GEEKPARK_ADMIN_BASE=https://admin.geekpark.net
WEBSITE_GEEKPARK_PUBLIC_BASE=https://www.geekpark.net
WEBSITE_GEEKPARK_ROLES=dev

# Sites 前端向独立 Python API 转发；本地默认值为 http://127.0.0.1:8000
PUBLISHER_BACKEND_URL=http://127.0.0.1:8000
